# === AI 生图配置 (Node.js + Python 共用) ===
AI_IMAGE_PROVIDER=mock          # mock | http
AI_IMAGE_DRY_RUN=true           # true: 只生成任务文件，不调用真实 API
AI_IMAGE_API_URL=               # http 模式下的生图 API 地址
AI_IMAGE_API_KEY=               # http 模式下的 API Key
OUTPUT_DIR=output

# === Node.js 服务器 ===
PORT=3000
HOST=127.0.0.1
CORS_ALLOW_ORIGIN=              # 前端跨域来源，如 http://localhost:3000

# === 数据库 (Python FastAPI) ===
DATABASE_URL=sqlite:///./aigallery.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/aigallery

# === 腾讯云 COS ===
COS_REGION=ap-shanghai
COS_APPID=1427746697
COS_SECRET_ID=                  # 主账号 SecretId
COS_SECRET_KEY=                 # 主账号 SecretKey
COS_SUB_SECRET_ID=              # 子账号 SecretId（可选，优先于主账号）
COS_SUB_SECRET_KEY=             # 子账号 SecretKey（可选）
COS_BUCKET_REF=ai-fashion-ref-shanghai-1427746697
COS_BUCKET_GEN=ai-fashion-gen-shanghai-1427746697

# === 商汤 SenseNova 生图 ===
SENSE_API_BASE=https://token.sensenova.cn/v1
SENSE_API_KEY=
SENSE_CHAT_MODEL=sensenova-6.7-flash-lite
SENSE_IMAGE_MODEL=sensenova-u1-fast
SENSE_IMAGE_SIZE=1920x1080

# === GBrain 知识库客户端 ===
# GBrain 是腾讯云多 Agent 工作流的知识库与自省中心
# 集成规则 (pi-agent.md):
#   - gbrainFirst: 任务开始前查询 GBrain 获取参考
#   - recordEverything: 记录任务决策到 GBrain
#   - syncAfterWrite: 写入后触发索引同步
#   - selfApproving: 任务完成后触发自省
#   - autoSelfApproving: 自动自省并存储
GBRAIN_API_URL=              # GBrain API 地址，如 http://100.92.38.117:8081
                              # 留空时自动降级为本地模式（gbrainEnabled=false）
GBRAIN_TIMEOUT_MS=30000      # 请求超时（毫秒），默认 30 秒
                              # 超时后自动降级，不影响主流程执行
